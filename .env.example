# Required
MONGO_URI=
JWT_SECRET=

# Server
NODE_ENV=development
PORT=5000
TRUST_PROXY=

# CORS — comma-separated origins (required for production/staging custom domains)
CORS_ORIGINS=

# Optional admin bootstrap (development / first deploy)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Rate limits
API_RATE_LIMIT_MAX=
ADMIN_RATE_LIMIT_MAX=
UPLOAD_RATE_LIMIT_MAX=

# MongoDB pool / retries
MONGODB_CONNECT_RETRIES=
MONGODB_CONNECT_RETRY_DELAY_MS=
MONGODB_MAX_POOL_SIZE=
MONGODB_MIN_POOL_SIZE=
MONGODB_SLOW_QUERY_MS=
MONGODB_HEALTH_PING_CACHE_MS=

# Redis (optional — in-memory cache fallback when unset)
REDIS_URL=
REDIS_KEY_PREFIX=
REDIS_COMMAND_TIMEOUT_MS=

# Cloudinary (optional — image upload disabled when unset)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Web push VAPID (optional)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Email SMTP (optional)
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# SMS / OTP Twilio (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_PHONE_NUMBER=

# OAuth / social login (optional)
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=

# App URLs
CUSTOMER_APP_URL=
APP_NAME=

# Security / ops
MASTER_KEY=
AUTH_SESSION_CACHE_TTL_SEC=
REGISTRATION_OTP_TTL_SEC=

# Load resilience (optional tuning)
SPIKE_WINDOW_MS=
SPIKE_MAX_PER_USER=
SPIKE_MAX_PER_IP=
DEGRADE_LOAD_THRESHOLD=

# PM2 cluster
PM2_INSTANCES=
NODE_APP_INSTANCE=
