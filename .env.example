# ─── Runtime ───
# NODE_ENV=production
# PORT=5000
# Behind Nginx (optional VPS later):
# TRUST_PROXY=1

# ─── MongoDB (Atlas — current production) ───
# Keep mongodb+srv://... after plan downgrade; no code/URI format change required.
MONGO_URI=
# Tuned for Free / Flex / shared Atlas (limited connections).
# Total ≈ PM2 workers × maxPoolSize — stay well under Atlas connection limit.
MONGODB_MAX_POOL_SIZE=15
MONGODB_MIN_POOL_SIZE=1
# When upgrading to dedicated (M10+):
# MONGODB_MAX_POOL_SIZE=50
# MONGODB_MIN_POOL_SIZE=10

# ─── Redis (shared cache + rate limits across PM2 workers) ───
REDIS_URL=redis://127.0.0.1:6379
REDIS_KEY_PREFIX=offers:
AUTH_SESSION_CACHE_TTL_SEC=60

# ─── PM2 cluster ───
# Free/Flex Atlas: keep 1–2. Dedicated Atlas / strong host: 2–4.
PM2_INSTANCES=2
# Optional full VPS stack later: deploy/vps/ (deferred — not active)

# ─── Load resilience ───
# SPIKE_MAX_PER_USER=80
# SPIKE_MAX_PER_IP=120
# API_RATE_LIMIT_MAX=600

# ─── JWT ───
JWT_SECRET=

# ─── App URLs ───
APP_NAME=Offers Tech
CUSTOMER_APP_URL=http://localhost:5173

# ─── Email (SMTP) — اختياري؛ بدونها يُعطّل توثيق البريد ولا يُمنع التسجيل/الدخول ───
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ─── SMS (Twilio) — مطلوب في الإنتاج ───
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ─── Google OAuth (نفس Client ID في customerFrontend) ───
GOOGLE_CLIENT_ID=

# ─── TikTok Login Kit ───
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# يجب أن يطابق VITE_TIKTOK_REDIRECT_URI في الفرونت
TIKTOK_REDIRECT_URI=http://localhost:5173/login

# Facebook: لا يحتاج Backend secret — التحقق عبر Graph API بـ access token من المتصفح

# ─── Admin seed (اختياري) ───
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ─── CORS ───
# التطوير: localhost. الإنتاج: نطاقات الواجهات فقط (مفصولة بفواصل)
# لا تستخدم * مع credentials: true
# CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
# CORS_ORIGINS=https://winzor-customer.mhmdalhjeen.workers.dev,https://winzor.netlify.app,https://supplierwz.netlify.app,https://YOUR-ADMIN.netlify.app
CORS_ORIGINS=http://localhost:5173,https://winzor-customer.mhmdalhjeen.workers.dev

# ─── Web Push (VAPID) — required for OS/browser push notifications ───
# Generate keys: npx web-push generate-vapid-keys
# VAPID_SUBJECT: mailto:admin@yourdomain.com OR https://your-customer-pwa-url
# If VAPID_SUBJECT is empty, CUSTOMER_APP_URL is used as the subject fallback.
# Without all three values, in-app MongoDB notifications still work but Web Push is disabled.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# ─── Cloudinary (رفع الصور) ───
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
